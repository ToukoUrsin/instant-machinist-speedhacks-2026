    "type": "changed-count",
    "resource": "invoiceitems",
    "kind": "created",
    "count": 5
   },
   {
    "id": "right-customer",
    "label": "Draft is for the RFQ customer cus_kestrel",
    "type": "record-field",
    "resource": "invoices",
    "recordId": "in_MslT6GOQaeLYFM7h",
    "path": [
     "customer"
    ],
    "op": "equals",
    "value": "cus_kestrel"
   },
   {
    "id": "deposit-total",
    "label": "Draft totals the 50% deposit (43710 cents of 87420)",
