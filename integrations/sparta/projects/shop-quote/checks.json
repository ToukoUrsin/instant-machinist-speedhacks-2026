 "ftc10-deposit": {
  "assertions": [
   {
    "id": "one-draft",
    "label": "Exactly one new invoice",
    "type": "changed-count",
    "resource": "invoices",
    "kind": "created",
    "count": 1
   },
   {
    "id": "five-items",
