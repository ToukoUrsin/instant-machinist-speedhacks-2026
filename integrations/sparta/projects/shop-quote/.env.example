# Not needed with ../../tools/run.sh (it injects ANTHROPIC_API_KEY from the environment and sets these limits).
# For a manual run: copy to .env (gitignored) and run `node --env-file=.env ../../agent/quote-agent.mjs` under the worlds runner.
WORLDS_MODEL_PROVIDER=anthropic
WORLDS_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
WORLDS_AGENT_MAX_STEPS=12
WORLDS_AGENT_MAX_TOKENS=1024
WORLDS_AGENT_TIMEOUT_MS=120000
